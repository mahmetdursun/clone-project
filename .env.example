# Tedarikçi web servis kimlik bilgileri.
# Gerçek değerleri buraya DEĞİL, .env.local dosyasına yazın (.env.local git'e girmez).

# --- Veritabanı (master ürün / OEM / tedarikçi ürün eşleştirme şeması) ---
# Postgres bağlantı string'i. Henüz bir Postgres örneğiniz yoksa: ofis
# sunucunuzda (92.44.217.13) kendi Postgres'inizi kurabilir, ya da Neon/
# Supabase/Railway gibi yönetilen bir servis kullanabilirsiniz.
DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Kimlik doğrulama (Auth.js / NextAuth v5) ---
# Oturum JWT'lerini imzalamak için rastgele, gizli bir anahtar. Üretmek için:
#   openssl rand -base64 32
# .env.local'de tanımlı değilse Auth.js geliştirme modunda otomatik bir
# anahtar üretir ama PRODUCTION'da MUTLAKA kendi anahtarınızı tanımlayın.
AUTH_SECRET=

# Google ile giriş — Google Cloud Console > APIs & Services > Credentials'ta
# oluşturulan OAuth 2.0 Client ID. İkisi de boşsa "Google ile Devam Et"
# butonu sessizce devre dışı kalır, siteniz e-posta/şifre ile çalışmaya
# devam eder.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook ile giriş — developers.facebook.com'da oluşturulan uygulamanın
# App ID / App Secret'ı. İkisi de boşsa "Facebook ile Devam Et" butonu
# sessizce devre dışı kalır.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Cloudflare Turnstile (görünmez CAPTCHA / bot koruması) — Cloudflare
# dashboard'da Turnstile için bir site oluşturunca alacağınız anahtarlar.
# NEXT_PUBLIC_ olan tarayıcıya gönderilir (gizli değildir), SECRET_KEY ise
# sadece sunucuda kullanılır ve asla NEXT_PUBLIC_ ön eki almamalıdır.
# İkisi de boşsa kayıt/giriş formlarında Turnstile widget'ı gösterilmez,
# akış olduğu gibi (rate limiting + bcrypt + oturum güvenliği ile) çalışır.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- DEGA (İler Otomotiv) B4B web servisi ---
DEGA_B4B_BASE_URL=https://b4b.de-ga.com.tr
DEGA_B4B_EMAIL=
DEGA_B4B_PASSWORD=

# --- Delta (eryaz.net entegrasyonu) web servisi ---
# Not: DELTA_PASSWORD içinde # karakteri var, .env.local'da tırnak içine
# alın (ör. DELTA_PASSWORD="ornek#sifre") yoksa # sonrası kesilebilir.
DELTA_API_URL=https://share.eryaz.net/api/Integration/getdata
DELTA_COMPANY_KEY=
DELTA_USERNAME=
DELTA_PASSWORD=
